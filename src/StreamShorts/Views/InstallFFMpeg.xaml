<UserControl
    x:Class="StreamShorts.Views.InstallFFMpeg"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:StreamShorts.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="FFMpeg and FFProbe is required. Click below to download it.  Then drag and drop both zip file in the drop zone to install." />
            <Button
                HorizontalAlignment="Center"
                Command="{Binding OpenHttpLinkCommand}"
                Content="https://ffbinaries.com/downloads"
                Style="{DynamicResource HyperlinkStyledButton}"
                ToolTip="Some custom tooltip" />
        </StackPanel>
        <Grid
            Grid.Row="1"
            AllowDrop="True"
            Background="LightGray">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Drop">
                    <i:InvokeCommandAction Command="{Binding DropCommand}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="Drop FFMpeg Zip Here" />
        </Grid>
    </Grid>
</UserControl>
