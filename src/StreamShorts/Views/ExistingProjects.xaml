<UserControl
    x:Class="StreamShorts.Views.ExistingProjects"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviours="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conv="clr-namespace:StreamShorts.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StreamShorts.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="_this"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <behaviours:Interaction.Triggers>
        <behaviours:EventTrigger EventName="Loaded">
            <behaviours:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </behaviours:EventTrigger>
    </behaviours:Interaction.Triggers>
    <UserControl.Resources>
        <conv:ByteSizeToHumanConverter x:Key="ByteSizeToHumanConverter" />
        <conv:ProjectPreviewPathConverter x:Key="ProjectPreviewPathConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button
            Margin="3"
            Command="{Binding SettingsCommand}"
            Content="&#xE713;"
            FontFamily="Segoe MDL2 Assets"
            FontSize="24" />
        <Button
            Grid.Column="2"
            Margin="3"
            Command="{Binding AddProjectCommand}"
            Content="Add Project" />
        <ScrollViewer
            Grid.Row="1"
            Grid.ColumnSpan="3"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ProjectRepo.Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="true" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="2"
                            BorderBrush="Black"
                            BorderThickness="1">
                            <Grid Width="250" Height="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.ColumnSpan="2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{Binding DataContext.OpenProjectCommand, ElementName=_this}"
                                    CommandParameter="{Binding}">
                                    <Image Margin="5">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource ProjectPreviewPathConverter}">
                                                <Binding Path="Preview" />
                                                <Binding Path="ProjectName" />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{Binding DataContext.OpenProjectCommand, ElementName=_this}"
                                    CommandParameter="{Binding}">

                                    <TextBlock
                                        Cursor="Hand"
                                        Foreground="DodgerBlue"
                                        Text="{Binding ProjectName}"
                                        TextDecorations="Underline"
                                        TextWrapping="WrapWithOverflow" />
                                </Button>
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="5"
                                    Text="{Binding TotalSizeInBytes, Converter={StaticResource ByteSizeToHumanConverter}}" />
                                <Button
                                    Grid.Row="3"
                                    Margin="3"
                                    Command="{Binding DataContext.DeleteProjectCommand, ElementName=_this}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE653;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="24"
                                    ToolTip="Delete" />
                                <Button
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="3"
                                    Command="{Binding DataContext.OpenProjectCommand, ElementName=_this}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE104;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="24"
                                    ToolTip="Open" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
