<UserControl
    x:Class="StreamShorts.Views.AddProject"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:conv="clr-namespace:StreamShorts.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StreamShorts.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <ScrollViewer>
        <StackPanel Margin="20" VerticalAlignment="Top">
            <TextBox
                Width="300"
                Margin="0,0,0,10"
                Padding="0,0,0,4"
                conv:TextBoxHelper.Placeholder="YouTube URL"
                Text="{Binding YouTubeUrl, Mode=TwoWay}" />
            <TextBox
                Width="300"
                Margin="0,0,0,10"
                Padding="0,0,0,4"
                conv:TextBoxHelper.Placeholder="Project Name"
                Text="{Binding ProjectName, Mode=TwoWay}" />
            <Button
                Width="100"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Command="{Binding AddProjectCommand}"
                Content="Add Project" />
            <Button
                Width="100"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
